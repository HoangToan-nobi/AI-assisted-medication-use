# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (DeepSeek — mặc định) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---- LLM Configuration (OpenAI, KHONG dung trong deployment hien tai) ----
# Khong xuat hien trong bien moi truong Render that - de trong, chi can neu ban
# tu doi provider LLM cuc bo.
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# DB chinh (users, medications, products, interaction_checks, ...) - Postgres tren
# Supabase, xin connection string that tu leader/team, KHONG dung gia tri mau ben
# duoi. Nhanh production la connection string rieng, chi dung luc deploy, khong
# chia se rong.
DATABASE_URL=postgresql://user:password@xxxx.supabase.co:5432/postgres
# For SQLite (dev offline, khong sync voi team):
# DATABASE_URL=sqlite:///./data/app.db

# DB "facts" (chi chua 3 bang interactions/food_interactions/disease_interactions,
# tach khoi DATABASE_URL de tranh vuot quota 0.5GB cua Supabase free tier) -
# CockroachDB Serverless, xin connection string that tu leader/team. De trong thi
# code tu dong fallback dung DATABASE_URL cho ca 3 bang nay (xem
# FACTS_TABLE_NAMES trong src/db/session.py) - phu hop dev local voi SQLite gop
# chung 1 file, KHONG dung fallback nay cho Postgres/Supabase vi ban trong
# Supabase co the la du lieu cu da tach di roi.
DATABASE_URL_FACTS=

# ---- Vector Store (KHONG dung trong deployment hien tai) ----
# Khong xuat hien trong bien moi truong Render that - co service module san
# (src/services/vector_store.py) nhung chua duoc dung trong luong kiem tra tuong
# tac chinh. De trong neu khong dang phat trien tinh nang lien quan.
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4, KHONG dung trong deployment hien tai) ----
# Khong xuat hien trong bien moi truong Render that - chi can neu ban tu bat
# tracing LangSmith cuc bo.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Authentication ----
SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
ENABLE_DEMO_ACCOUNTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Cac ten tuong thich: SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_USE_TLS
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=1
# Gmail API (OAuth) - dung thay SMTP tren host chan outbound SMTP (vd Render).
# Khi GMAIL_OAUTH_REFRESH_TOKEN co gia tri, backend gui mail qua Gmail API (HTTPS)
# thay vi SMTP. Xem docs/gmail-api-setup.md de lay 3 gia tri nay.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ---- OCR service (quét đơn thuốc) ----
# Chạy tay trên máy: OCR service né cổng 8000 (backend đã chiếm), tự chạy ở 8001.
# Qua docker-compose: biến này bị ghi đè thành http://ocr:8000 (mạng nội bộ compose).
# Production: URL Modal in ra sau `modal deploy` (xem ocr-service/modal_app.py).
OCR_SERVICE_URL=http://localhost:8001
OCR_TIMEOUT_SECONDS=90
# Proxy Auth Token của Modal (Modal dashboard -> Settings -> Proxy Tokens) - để
# trống khi ocr-service chạy local qua docker-compose (không cần xác thực).
MODAL_KEY_ID=
MODAL_KEY_SECRET=
