# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (DeepSeek — mặc định) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---- LLM Configuration (OpenAI, không dùng mặc định) ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Postgres chung tren Neon (nhanh "dev") - xin connection string that tu leader/team,
# KHONG dung gia tri mau ben duoi. Nhanh "main" (production) la connection string rieng,
# chi dung luc deploy, khong chia se rong.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# For SQLite (dev offline, khong sync voi team):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Authentication ----
SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
ENABLE_DEMO_ACCOUNTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Cac ten tuong thich: SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_USE_TLS
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=1
# Gmail API (OAuth) - dung thay SMTP tren host chan outbound SMTP (vd Render).
# Khi GMAIL_OAUTH_REFRESH_TOKEN co gia tri, backend gui mail qua Gmail API (HTTPS)
# thay vi SMTP. Xem docs/GMAIL_API_SETUP.md de lay 3 gia tri nay.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
