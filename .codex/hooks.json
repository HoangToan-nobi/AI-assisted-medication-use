{
  "description": "AI20K AI usage logging",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/log_codex_hook.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/log_codex_hook.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
