docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
.next-stale-*/
.next.stale-*/
out/
.nuxt/
*.tsbuildinfo

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Eval — track harness/datasets/report, ignore run outputs (capture.jsonl, per-case JSON)
eval/results/runs/
.vercel
.env*

# Ảnh đơn thuốc chứa thông tin bệnh nhân (họ tên, CCCD, BHYT, số điện thoại).
# Không bao giờ được đưa lên git: đã push là nằm vĩnh viễn trong lịch sử.
.cursor/
*.zip

# Eval — chỉ track báo cáo chính thức (final_report.md), 2 bản judge_summary và
# số liệu judge của đợt heldout/claude_full. Phiếu chấm tay, biên bản hiệu chỉnh
# giữa 2 người chấm và bản nháp cũ giữ trên máy, không đưa vào git.
eval/results/report.md
eval/results/manual_test_cases.md
eval/results/judge_summary.md
eval/results/judge_completeness.json
eval/results/judge_consistency.json
